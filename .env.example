# Copiez ce fichier en .env et complétez les valeurs. Ne commitez jamais le vrai .env.

# ─── Shopify ─────────────────────────────────────────────────────────────────
# Renseignées automatiquement par `shopify app dev` ; à définir vous-même en production.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://votre-app.example.com
# Doit être identique à access_scopes.scopes du TOML déployé.
SCOPES=read_orders,write_orders,read_returns,write_returns,read_customers,read_products,read_fulfillments,read_assigned_fulfillment_orders,read_merchant_managed_fulfillment_orders,read_draft_orders,write_draft_orders,write_gift_cards,read_store_credit_accounts,read_store_credit_account_transactions,write_store_credit_account_transactions,read_locations
# "production" = vrais paiements. Toute autre valeur = facturation de test.
BILLING_MODE=development

# ─── Base de données (PostgreSQL) ────────────────────────────────────────────
# Utilisez une base (ou une branche Neon) dédiée au développement :
# `npm run dev` exécute `prisma db push` sur cette base.
DATABASE_URL=postgresql://user:password@host:5432/trackback

# ─── Sécurité ────────────────────────────────────────────────────────────────
# Signe les jetons du portail, du chat et des liens de suivi (défaut : SHOPIFY_API_SECRET).
# Le modifier invalide les liens de suivi déjà envoyés par e-mail.
TOKEN_SECRET=
# Protège /api/cron/daily (Vercel l'envoie automatiquement en Bearer).
CRON_SECRET=

# ─── E-mails (SMTP) ──────────────────────────────────────────────────────────
SMTP_HOST=
# 587 = STARTTLS, 465 = SSL
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Adresse d'expédition (défaut : SMTP_USER). Les réponses des clients vont à l'e-mail de réponse du marchand.
MAIL_FROM=
SMTP_FROM_NAME=TrackBack

# ─── Cloudinary (logos et photos des retours) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Optionnel ───────────────────────────────────────────────────────────────
# Notifie l'équipe TrackBack des messages du chat support marchand.
DISCORD_WEBHOOK_URL=
# Protège la console de support (/support-console) et son API de réponse.
SUPPORT_REPLY_TOKEN=
# Version de la Graph API Meta pour les notifications WhatsApp automatiques.
WHATSAPP_GRAPH_VERSION=v23.0
# Domaine de boutique personnalisé (option du template Shopify).
SHOP_CUSTOM_DOMAIN=
